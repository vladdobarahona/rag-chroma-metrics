# Token de GitHub con acceso a GitHub Models (Settings > Developer settings > Personal access tokens)
# No requiere scopes especiales para el catálogo de modelos gratuito.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endpoint del catálogo de GitHub Models (compatible con SDK de OpenAI)
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com

# Modelos usados (ver catálogo actualizado en https://github.com/marketplace/models)
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Carpeta donde persiste Chroma
CHROMA_PERSIST_DIR=./chroma_db
